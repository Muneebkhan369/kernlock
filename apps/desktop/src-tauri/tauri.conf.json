{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KernLock Security",
  "version": "0.1.0",
  "identifier": "io.kernlock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KernLock Security — Detect. Block. Explain.",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:17420"
    }
  }
}
