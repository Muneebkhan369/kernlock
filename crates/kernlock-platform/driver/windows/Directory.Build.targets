<Project>
  <PropertyGroup>
    <SignMode Condition="'$(SignMode)' == ''">Off</SignMode>
  </PropertyGroup>

  <!-- Conditional Windows SDK C++ Targets -->
  <Import Project="$(WdkPackagesDir)Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.targets" Condition="Exists('$(WdkPackagesDir)Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.targets')" />
  <Import Project="$(WdkPackagesDir)Microsoft.Windows.SDK.CPP.10.0.26100.3323\build\native\Microsoft.Windows.SDK.cpp.targets" Condition="Exists('$(WdkPackagesDir)Microsoft.Windows.SDK.CPP.10.0.26100.3323\build\native\Microsoft.Windows.SDK.cpp.targets')" />
  <Import Project="$(WdkPackagesDir)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.targets" Condition="Exists('$(WdkPackagesDir)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.targets')" />

  <!-- Override post-build packaging verification targets that require missing x86 tools in x64 WDK NuGet package -->
  <!-- Note: StampInf remains fully active and executes stampinf.exe on kernlock_filter.inf -->
  <Target Name="InfVerif" />
  <Target Name="ApiValidator" />
</Project>
