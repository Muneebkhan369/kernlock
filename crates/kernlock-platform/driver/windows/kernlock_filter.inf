;;;
;;; KernLock Security - Filesystem Minifilter Driver INF
;;;

[Version]
Signature   = "$Windows NT$"
Class       = "AntiVirus"
ClassGuid   = {b1d0f7d1-497d-4e53-8fbb-a72e20e0ec08}
Provider    = %ProviderString%
DriverVer   = 11/12/2026,1.0.0.0
CatalogFile = kernlock_filter.cat

[DestinationDirs]
DefaultDestDir          = 12
MiniFilter.DriverFiles  = 12            ;%windir%\system32\drivers

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
kernlock_filter.sys = 1,,

[DefaultInstall]
OptionDesc          = %ServiceDescription%
CopyFiles           = MiniFilter.DriverFiles

[DefaultInstall.Services]
AddService          = %ServiceName%,,MiniFilter.Service

[MiniFilter.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys
Dependencies     = "FltMgr"
ServiceType      = 2                            ;SERVICE_FILE_SYSTEM_DRIVER
StartType        = 3                            ;SERVICE_DEMAND_START
ErrorControl     = 1                            ;SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Anti-Virus"
AddReg           = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,,"DebugFlags",0x00010001,0x0
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[MiniFilter.DriverFiles]
%DriverName%.sys

[Strings]
ProviderString          = "KernLock Security"
ServiceDescription      = "KernLock Endpoint Security Minifilter Driver"
ServiceName             = "KernLockFilter"
DriverName              = "kernlock_filter"
DiskId1                 = "KernLock Installation Disk"

DefaultInstance         = "KernLockFilter - Top Instance"
Instance1.Name          = "KernLockFilter - Top Instance"
Instance1.Altitude      = "325000"
Instance1.Flags         = 0x0
